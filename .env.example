ANTHROPIC_API_KEY=sk-ant-xxxx
CREATOR_NAME=Ramon
NEXUS_MODEL=claude-sonnet-4-6

# Opcional: para a Nexus rodar comandos via SSH nos seus IPs de teste.
# Use uma chave dedicada, sem senha em texto puro, com BatchMode (sem prompt).
SSH_USER=
SSH_KEY_PATH=

# Opcional: webhook para notificações fora do terminal (alertas autônomos
# chegam aqui mesmo quando você não está olhando o chat). Slack incoming
# webhook ou Discord webhook funcionam direto; "raw" envia {title, message}.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=slack

# Opcional: Slack Web API (preferida sobre o webhook acima, se ambos
# configurados). Bot User OAuth Token (Slack app -> OAuth & Permissions)
# com escopo chat:write, + ID do canal (clique no nome do canal no Slack
# -> "ID do canal", formato C0123456789).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Signing secret do Slack app (Basic Information -> Signing Secret),
# necessário para o endpoint /slack/command (slash commands) funcionar.
SLACK_SIGNING_SECRET=

# Exploração ativa (Metasploit) — DESATIVADA por padrão. Só ligue se você
# entende que pode causar crash/instabilidade real até em alvos autorizados.
ALLOW_ACTIVE_EXPLOITATION=false
MSF_TIMEOUT_SECONDS=180

# Timeouts de cracking de senha (hashcat/john). Arquivos de hash e
# wordlists devem ficar em workdir/.
HASHCAT_TIMEOUT_SECONDS=300
JOHN_TIMEOUT_SECONDS=300

# Geração de conteúdo de engenharia social (phishing/pretexting simulado)
# — DESATIVADA por padrão. A Nexus só GERA TEXTO, nunca envia nada; exige
# uma referência de engagement (contrato/SOW) registrada na auditoria.
ALLOW_SOCIAL_ENGINEERING=false

# Timeouts de Hydra (brute force) e SQLMap (injeção SQL automatizada).
# Ambos usam ALLOW_ACTIVE_EXPLOITATION (já definido acima) como toggle.
HYDRA_TIMEOUT_SECONDS=300
SQLMAP_TIMEOUT_SECONDS=300

# A cada quantos segundos a trilha de auditoria é ancorada externamente
# (via notificação) para detectar truncamento (remoção de eventos do
# final do hash chain).
AUDIT_CHECKPOINT_INTERVAL=1800

# Honeypot: porta-armadilha. Qualquer IP que conectar é isolado
# automaticamente. Desativado por padrão — abrir uma porta é deliberado.
HONEYPOT_ENABLED=false
HONEYPOT_PORT=2222
HONEYPOT_BANNER=SSH-2.0-OpenSSH_7.4\r\n
# Múltiplos honeypots simultâneos: "service:port" separados por vírgula.
# ftp e http capturam usuário/senha reais digitados pelo atacante.
HONEYPOT_SERVICES=ssh:2222,ftp:2121,http:8081

# A cada quantos segundos o watchdog verifica e reinicia honeypots caídos.
WATCHDOG_INTERVAL=60

# A cada quantas horas a Nexus envia um resumo executivo via notificação.
REPORT_INTERVAL_HOURS=24

# Mikrotik RouterOS (ex: RB750) — acesso via API nativa.
# Porta 8728 = sem TLS (só em rede local confiável).
# Porta 8729 + MIKROTIK_USE_TLS=true = obrigatório para acesso pela internet.
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728
MIKROTIK_USE_TLS=false

# Feeds externos de threat intelligence — todos opcionais, todos com tier
# gratuito. Sem a chave, a consulta correspondente avisa que não está
# configurada, sem quebrar nada.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# Reporta automaticamente ao AbuseIPDB todo IP que a Nexus confirma isolar
# (só tem efeito com ABUSEIPDB_API_KEY configurada acima).
AUTO_REPORT_ABUSEIPDB=true

# A cada quantas horas os feeds globais (Spamhaus DROP, Feodo Tracker,
# Emerging Threats) são atualizados.
THREAT_FEED_REFRESH_INTERVAL_HOURS=1

# DPI (Suricata): interface a capturar. Vazio = não inicia automaticamente.
DPI_INTERFACE=

# Honeytokens: URL pública (domínio/IP da Xfiber alcançável de fora) usada
# no callback dos arquivos-isca. Sem isso, plant_decoy_file avisa que não
# tem como funcionar de verdade.
CANARY_BASE_URL=
CANARY_LISTENER_PORT=8090

# Resposta autônoma escalonada (Fase 4):
# Nível máximo que os playbooks executam sem pedir confirmação.
#   0 = só avalia e sugere (padrão — não age por conta própria)
#   1 = aplica rate limiting automaticamente
#   2 = rate limiting + isolamento local automático
#   4 = nível 2 + reporte automático ao AbuseIPDB
# Nível 3 (BGP FlowSpec) SEMPRE requer gate de confirmação.
PLAYBOOK_AUTO_LEVEL=0

# Habilita bloqueio de ASN inteiro (todos os prefixos IP de uma rede
# autônoma). BLAST RADIUS ALTO — pode bloquear tráfego legítimo do mesmo
# provedor. Mesmo habilitado, sempre passa pelo gate de confirmação.
ALLOW_ASN_BLOCK=false

# Fase 5 — Conhecimento da infraestrutura própria:
# Intervalo do inventário automático de ativos (scan periódico dos blocos
# IP próprios). 3600 = 1 hora. 0 = desativado.
ASSET_INVENTORY_SCAN_INTERVAL=3600
# Modo de scan: 'passive' (só ping, mais rápido) ou 'light' (ping + top
# 100 portas TCP, detecta serviços como Mikrotik API, DNS, etc.).
ASSET_INVENTORY_SCAN_MODE=passive

# Monitoramento dos DNS servers (resolvers .90/.91/.92): health check +
# auditoria de portas + validade de certificado DoT/DoH. Intervalo em
# segundos do loop; 0 = desativado (cadastre os servers e ligue depois).
DNS_MONITOR_INTERVAL=0
# IPs a cadastrar no boot, separados por vírgula. Cada um vira infraestrutura
# CRÍTICA (nunca auto-bloqueada). Ex.: 192.168.0.90,192.168.0.91,192.168.0.92
DNS_SERVERS=
# Domínio resolvido em cada health check (mede resposta/latência do resolver).
DNS_PROBE_DOMAIN=example.com
# Avisa quando o cert TLS (853/443) estiver a menos de N dias de expirar.
DNS_CERT_WARN_DAYS=30

# BrbOS — SO de servidor DNS da BrByte nos resolvers da Xfiber. Integração
# via API REST (login por cookie na mesma porta da interface web, padrão 8080).
# Dá visão DE DENTRO do DNS: estatísticas de consultas + bloqueio de domínio
# (RPZ) + rate limit. Vazio = tools de BrbOS avisam "não configurado".
# OBS de segurança: se acessar pela internet, use HTTPS/VPN — credenciais por
# HTTP em IP público trafegam em texto puro.
BRBOS_HOST=
BRBOS_PORT=8080
BRBOS_USER=
BRBOS_PASSWORD=
BRBOS_USE_TLS=false
# Habilita ESCRITA (bloqueio de domínio via RPZ). Desativado por padrão; mesmo
# habilitado, todo bloqueio passa pelo gate de confirmação (risk.py). Leitura
# de estatísticas/RPZ/rate limit funciona sem este toggle.
ALLOW_BRBOS_BLOCK=false
# Domínios próprios que a Nexus NUNCA pode bloquear (sufixos, separados por
# vírgula). Ex.: xfiber.com.br,xfiber.local — recomendado preencher.
BRBOS_PROTECTED_DOMAINS=

# Sandbox de malware (Fase 6). Análise ESTÁTICA + extração de IOC roda sempre
# (não executa nada). A detonação DINÂMICA exige DUAS travas independentes E um
# backend wirado; nesta versão não há backend, então nenhum caminho de código
# executa a amostra. NUNCA detonar em produção/dev — só host sacrificial isolado.
ALLOW_MALWARE_DETONATION=false
# Prova de ambiente de lab isolado (qualquer string não-vazia). Sem ele, a
# detonação recusa sem tocar na amostra mesmo com o toggle acima ligado.
MALWARE_SANDBOX_LAB_TOKEN=
# Backend de detonação (ex.: "cape"). Vazio = nenhum (fase 2, exige lab).
MALWARE_SANDBOX_BACKEND=
MALWARE_SANDBOX_TIMEOUT_SECONDS=120

# Auto-ajuste de thresholds (Fase 7, item 4). A Nexus aprende com o feedback do
# operador (falso positivo / verdadeiro / detecção perdida) e recalibra o
# z-score sozinha — SEMPRE dentro de limites rígidos (piso/teto hardcoded em
# tools/threshold_tuning). Off por padrão: sem este toggle, a Nexus só PROPÕE;
# aplicar exige confirmação explícita do operador (confirm=True). Ligar só
# habilita um futuro loop autônomo a aplicar dentro dos limites.
ALLOW_THRESHOLD_AUTOTUNE=false

# === Operação de ISP / NOC (Fase 8): inadimplência + monitoramento ===
# Liga o loop diário de bloqueio de inadimplentes / reativação de quem pagou.
# Off por padrão; uma vez ligado, age automaticamente no horário (limitado pelo
# cap de segurança abaixo). Reusa a API RouterOS do MikroTik (tools/mikrotik.py).
SUBSCRIBER_BILLING_ENABLED=false
# Hora (0-23) do ciclo diário e dias mínimos de atraso para bloquear.
SUBSCRIBER_BLOCK_HOUR=8
SUBSCRIBER_BLOCK_DAYS=5
# CAP DE SEGURANÇA: um ciclo que bloquearia MAIS que isto de uma vez NÃO
# bloqueia ninguém — só alerta (proteção contra erro na fonte de cobrança
# derrubar a base). Suba deliberadamente para um bloqueio massivo legítimo.
SUBSCRIBER_BLOCK_MAX_BATCH=50
# Fonte de cobrança: 'local' (tabela subscribers no nexus.db) | 'external'
# (adaptador para o sistema real, ainda não wirado).
BILLING_SOURCE=local
# Monitoramento de equipamentos (Microkit/OLT/switch) por ping. Intervalo em
# segundos. 0 = desligado. Cadastre os equipamentos com add_monitored_device.
DEVICE_MONITOR_INTERVAL=0
# Telegram — canal de notificação adicional (aditivo ao Slack/webhook). Token
# do bot (@BotFather) + chat/grupo de destino. Vazio = Telegram desligado.
# NUNCA commitar o token real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Controle bidirecional (operar o NOC pelo grupo do Telegram). Secret token do
# webhook: passe o mesmo valor em setWebhook(secret_token=...) e aqui. O
# endpoint /telegram/webhook recusa updates sem ele e só aceita comandos do
# TELEGRAM_CHAT_ID. Vazio = bidirecional desligado (Telegram só envia). Gere
# algo forte (ex.: openssl rand -hex 32) e NUNCA commite.
TELEGRAM_WEBHOOK_SECRET=
