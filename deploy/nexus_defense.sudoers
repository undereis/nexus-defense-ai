# Nexus Defense AI — NOPASSWD restrito apenas aos comandos pfctl exatos
# usados por tools/firewall.py. Nenhum outro comando é liberado.
# Instalar com: sudo visudo -c -f deploy/nexus_defense.sudoers && \
#               sudo install -m 440 deploy/nexus_defense.sudoers /etc/sudoers.d/nexus_defense

ramonreis ALL=(root) NOPASSWD: /sbin/pfctl -a nexus_defense -t nexus_blocklist -T add *
ramonreis ALL=(root) NOPASSWD: /sbin/pfctl -a nexus_defense -t nexus_blocklist -T delete *
ramonreis ALL=(root) NOPASSWD: /sbin/pfctl -a nexus_defense -t nexus_blocklist -T show
ramonreis ALL=(root) NOPASSWD: /sbin/pfctl -f /etc/pf.conf
ramonreis ALL=(root) NOPASSWD: /sbin/pfctl -e
ramonreis ALL=(root) NOPASSWD: /usr/bin/tee /etc/pf.anchors/nexus_defense
ramonreis ALL=(root) NOPASSWD: /usr/bin/tee -a /etc/pf.conf
ramonreis ALL=(root) NOPASSWD: /usr/bin/grep -q nexus_defense /etc/pf.conf
