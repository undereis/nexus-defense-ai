# Rendered by deploy/install_firewall_helper.sh. The root-owned helper validates
# the action, argument count, and IP/CIDR before invoking a fixed pfctl command.
__NEXUS_USER__ ALL=(root) NOPASSWD: /usr/local/libexec/nexus-firewall block *
__NEXUS_USER__ ALL=(root) NOPASSWD: /usr/local/libexec/nexus-firewall unblock *
__NEXUS_USER__ ALL=(root) NOPASSWD: /usr/local/libexec/nexus-firewall list
__NEXUS_USER__ ALL=(root) NOPASSWD: /usr/local/libexec/nexus-firewall rate-block *
__NEXUS_USER__ ALL=(root) NOPASSWD: /usr/local/libexec/nexus-firewall rate-unblock *
__NEXUS_USER__ ALL=(root) NOPASSWD: /usr/local/libexec/nexus-firewall rate-list
